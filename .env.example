# Discord application credentials (Developer Portal -> your app)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Comma-separated role IDs allowed to use /restart. Leave empty to allow anyone.
ALLOWED_ROLE_IDS=

# Channel ID the bot will respond in. Leave empty to allow any channel.
ALLOWED_CHANNEL_ID=

# Role ID pinged when the game process crashes. Leave empty for no ping.
CRASH_ALERT_ROLE_ID=

# systemd unit that runs the game server
SERVICE_NAME=valheim-vikea.service

# Minutes that must pass between /restart requests
RESTART_COOLDOWN_MINUTES=15

# Minutes of warning countdown before the restart actually happens
RESTART_COUNTDOWN_MINUTES=5

# Valheim's real-time seconds per in-game day (default is 1800 unless your server changes it)
DAY_LENGTH_SECONDS=1800

# RCON connection for in-game broadcasts (/announce and /restart countdown).
# Requires the rcon + Rcon_Commands + Server_devcommands BepInEx mods.
RCON_HOST=127.0.0.1
RCON_PORT=2458
RCON_PASSWORD=
